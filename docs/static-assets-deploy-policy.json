{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWebsiteAssets",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::vedantix.nl-bucket",
      "Condition": { "StringLike": { "s3:prefix": ["assets/", "assets/*"] } }
    },
    {
      "Sid": "PublishWebsiteAssets",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::vedantix.nl-bucket/assets/*"
    }
  ]
}
